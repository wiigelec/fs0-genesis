{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "plan_id",
    "changes"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "artifact_type": {
      "const": "plan-normative-changes"
    },
    "plan_id": {
      "type": "string",
      "minLength": 1
    },
    "changes": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "required": [
          "operation",
          "requirement"
        ],
        "properties": {
          "operation": {
            "type": "string",
            "minLength": 1
          },
          "requirement": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "required": [
              "id",
              "statement",
              "lifecycle",
              "evaluation"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "lifecycle": {
                "type": "string",
                "minLength": 1
              },
              "evaluation": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "object",
                "required": [
                  "conformance",
                  "assurance"
                ],
                "properties": {
                  "conformance": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "required": [
                      "applicability"
                    ],
                    "properties": {
                      "applicability": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "additionalProperties": true
                  },
                  "assurance": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "required": [
                      "applicability"
                    ],
                    "properties": {
                      "applicability": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "additionalProperties": true
                  }
                },
                "additionalProperties": true
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "invariants": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": true
}
