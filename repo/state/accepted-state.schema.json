{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fs0:accepted-state",
  "title": "FS0 accepted repository state",
  "type": "object",
  "required": [
    "schema_version",
    "record_type",
    "acceptance_id",
    "accepted_revision",
    "functional_set_id",
    "accepted_plan_id"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "record_type": {
      "const": "accepted-repository-state"
    },
    "acceptance_id": {
      "type": "string",
      "minLength": 1
    },
    "accepted_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "functional_set_id": {
      "type": "string",
      "minLength": 1
    },
    "accepted_plan_id": {
      "type": "string",
      "minLength": 1
    },
    "predecessor": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      ]
    }
  },
  "additionalProperties": true
}
